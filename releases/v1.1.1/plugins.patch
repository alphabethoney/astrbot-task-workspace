+            extra = await self._session_output(row) if row["status"] in ACTIVE else ""
+            return f"[Linux · {ws.title} · {row['id'][:14]}]\n" + (row["result_text"] or row["error"] or row["status"]) + ("\n" + extra if extra else "")
