+                if isinstance(content, str):
+                    message.content = sanitize_dsml(content, user, b["environment"])[0]
+                elif isinstance(content, list):
+                    for part in content:
+                        if getattr(part, "type", "") == "text":
+                            part.text = sanitize_dsml(part.text, user, b["environment"])[0]
